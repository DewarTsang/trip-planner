# ===========================================
# 智能旅行助手 — Docker 部署环境变量
# ===========================================
# 使用方法:
#   cp .env.docker.example .env.docker
#   编辑 .env.docker 填入你的密钥
#   docker compose --env-file .env.docker up -d --build

# ---------- LLM 配置 (必填) ----------
# 模型名称
LLM_MODEL_ID=deepseek-chat

# API 密钥
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 服务地址 (OpenAI 兼容 API)
# DeepSeek: https://api.deepseek.com
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI:   https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com

# 调用超时 (秒, 可选)
LLM_TIMEOUT=60

# ---------- 高德地图配置 (必填) ----------
# Web 服务 API Key (后端 POI 搜索/天气/路线/POI 图片)
# 申请: https://console.amap.com/dev/key/app
AMAP_API_KEY=你的高德Web服务Key

# Web 端 JS API Key (前端地图渲染, 必须是 JS API 类型)
# 注意: 与上面的 Web 服务 Key 是两个独立的 Key
VITE_AMAP_WEB_JS_KEY=你的高德Web端JS_Key

# ---------- 服务器配置 (可选) ----------
# 前端访问端口 (宿主机映射)
FRONTEND_PORT=8080

# CORS 白名单 (逗号分隔)
# 默认跟随 FRONTEND_PORT, 如部署到域名请改为 https://你的域名
CORS_ORIGINS=http://localhost:8080

# 日志级别
LOG_LEVEL=INFO
